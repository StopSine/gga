  </CheatEntries>
  <LuaScript>--[[
  Resolves the rdram base so every address above can be written as an offset.

  The allocation moves each launch, so the base is read from the global
  recomp_rdram_base that librecomp publishes at startup. Run this once after
  attaching; it registers "rdram" as a symbol the entries resolve against.
]]

function setRdramBase()
  local sym = "GGA64Recompiled.exe!recomp_rdram_base"
  local addr = getAddressSafe(sym) or getAddressSafe("recomp_rdram_base")

  if addr == nil then
    local typed = inputQuery("rdram base",
      "Symbol recomp_rdram_base not found.\nPaste the base the game logs at startup:", "")
    if typed == nil then return end
    unregisterSymbol("rdram")
    registerSymbol("rdram", tonumber(typed, 16), true)
    return
  end

  local base = readPointer(addr)
  if base == nil or base == 0 then
    showMessage("recomp_rdram_base is null - attach after the game has started.")
    return
  end

  unregisterSymbol("rdram")
  registerSymbol("rdram", base, true)
end

setRdramBase()

</LuaScript>
</CheatTable>
